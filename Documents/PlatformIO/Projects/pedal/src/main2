#include <Arduino.h>
#include "hardware/adc.h"
#include "hardware/dma.h"
#include "hardware/irq.h"

// ---- Config ----
// 48MHz ADC clock / 1200 = exactly 40000Hz, no rounding.
const uint32_t sample_rate    = 40000;
const uint     adcGpio        = 27;  // GP27 = ADC1 = board's "A1"
const uint     adcInputChannel = 1;

// ---- ADC ping-pong DMA buffers ----
#define ADC_BUF_LEN 64  // ~1.6ms/half at 40kHz
static uint16_t adc_buf[2][ADC_BUF_LEN];
static int dma_chan_a, dma_chan_b;

// ---- Ring buffer: DMA IRQ (producer) -> loop() (consumer, bulk Serial.write) ----
#define RING_SIZE 4096
volatile uint16_t ring[RING_SIZE];
volatile uint32_t ring_write = 0;
volatile uint32_t ring_read  = 0;
volatile uint32_t dropped_samples = 0; // diagnostic only

static inline void push_batch(const uint16_t* raw, int len) {
    for (int i = 0; i < len; i++) {
        uint32_t next = (ring_write + 1) % RING_SIZE;
        if (next != ring_read) {
            ring[ring_write] = raw[i];
            ring_write = next;
        } else {
            dropped_samples++;
        }
    }
}

void __isr dma_irq_handler() {
    if (dma_hw->ints0 & (1u << dma_chan_a)) {
        dma_hw->ints0 = 1u << dma_chan_a; // ack
        push_batch(adc_buf[0], ADC_BUF_LEN);
        // Reset addr/count so the NEXT chain-trigger from B refills this
        // buffer properly instead of firing a 0-length transfer.
        dma_channel_set_write_addr(dma_chan_a, adc_buf[0], false);
        dma_channel_set_trans_count(dma_chan_a, ADC_BUF_LEN, false);
    }
    if (dma_hw->ints0 & (1u << dma_chan_b)) {
        dma_hw->ints0 = 1u << dma_chan_b; // ack
        push_batch(adc_buf[1], ADC_BUF_LEN);
        dma_channel_set_write_addr(dma_chan_b, adc_buf[1], false);
        dma_channel_set_trans_count(dma_chan_b, ADC_BUF_LEN, false);
    }
}

void setup_adc_dma() {
    adc_init();
    adc_gpio_init(adcGpio);
    adc_select_input(adcInputChannel);

    adc_fifo_setup(
        true,  // write each conversion to the FIFO
        true,  // enable DMA data request (DREQ)
        1,     // assert DREQ as soon as 1 sample is available
        false, // no error bit
        false  // keep full 12-bit samples
    );
    adc_set_clkdiv((48000000.0f / (float)sample_rate) - 1.0f);

    dma_chan_a = dma_claim_unused_channel(true);
    dma_chan_b = dma_claim_unused_channel(true);

    dma_channel_config cfg_a = dma_channel_get_default_config(dma_chan_a);
    channel_config_set_transfer_data_size(&cfg_a, DMA_SIZE_16);
    channel_config_set_read_increment(&cfg_a, false);
    channel_config_set_write_increment(&cfg_a, true);
    channel_config_set_dreq(&cfg_a, DREQ_ADC);
    channel_config_set_chain_to(&cfg_a, dma_chan_b);
    dma_channel_configure(dma_chan_a, &cfg_a,
        adc_buf[0], &adc_hw->fifo, ADC_BUF_LEN, false);

    dma_channel_config cfg_b = dma_channel_get_default_config(dma_chan_b);
    channel_config_set_transfer_data_size(&cfg_b, DMA_SIZE_16);
    channel_config_set_read_increment(&cfg_b, false);
    channel_config_set_write_increment(&cfg_b, true);
    channel_config_set_dreq(&cfg_b, DREQ_ADC);
    channel_config_set_chain_to(&cfg_b, dma_chan_a);
    dma_channel_configure(dma_chan_b, &cfg_b,
        adc_buf[1], &adc_hw->fifo, ADC_BUF_LEN, false);

    dma_channel_set_irq0_enabled(dma_chan_a, true);
    dma_channel_set_irq0_enabled(dma_chan_b, true);
    irq_set_exclusive_handler(DMA_IRQ_0, dma_irq_handler);
    irq_set_enabled(DMA_IRQ_0, true);

    adc_fifo_drain();
    adc_run(true);
    dma_channel_start(dma_chan_a);
}

void setup() {
    Serial.begin(921600); // native USB CDC ignores the actual baud, but set it anyway
    while (!Serial) { }   // wait for the Python side to open the port
    setup_adc_dma();
}

void loop() {
    // Drain whatever's queued, in one bulk binary write. This is the
    // part that makes 40kHz possible -- no formatting, no per-sample
    // call overhead, just raw uint16 little-endian bytes.
    static uint16_t out_buf[256];
    uint32_t count = 0;
    while (count < 256 && ring_read != ring_write) {
        out_buf[count++] = ring[ring_read];
        ring_read = (ring_read + 1) % RING_SIZE;
    }
    if (count > 0) {
        Serial.write((uint8_t*)out_buf, count * sizeof(uint16_t));
    }
}

